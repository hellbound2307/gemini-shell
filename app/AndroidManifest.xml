<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.geminishell.app"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- The only permission this app needs. No storage, camera, location,
         contacts, or network-state access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/ShellTheme">

        <activity
            android:name="com.geminishell.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:theme="@style/ShellTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Diagnostic surface: renders the uncaught exception on screen and
             copies it to the clipboard. Not launchable, not exported. -->
        <activity
            android:name="com.geminishell.app.CrashActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault" />
    </application>
</manifest>